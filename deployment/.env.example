# Copy this file to .env in the repository root and fill in the values.
# Never commit the real .env file.

# development | testing | production
FLASK_CONFIG=development

# Random string of at least 32 characters (required in production). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left empty in development, a random key is used and sessions end when the server restarts.
SECRET_KEY=

# Leave empty for the default SQLite file in instance/dev.db.
# Production example: postgresql://user:password@host:5432/promptlib
DATABASE_URL=

# First administrator, created by: python deployment/seed.py
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
